{
  "position": "top",
  "layer": "top",
  "modules-left": ["custom/launcher","hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "battery", "custom/power"],
  "clock": {
    "format": "{:%A %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span size='13000'>{icon} </span>",
    "format-warning": "<span size='13000'>{icon} </span>",
    "format-critical": "<span size='13000'>{icon} </span>",
    "format-charging": "<span size='13000'> </span>",
    "format-plugged": "<span size='13000'> </span>",
    "format-alt": "<span size='13000'>{icon} </span> {time}",
    "format-full": "<span size='13000'> </span> ",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}"
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty --class impala-nm -e impala-nm",
  },
  "pulseaudio": {
      "format": "{icon}",
      "format-muted": "",
      "format-icons": {
          "default": ["", "", " "]
      },
      "on-click": "~/.config/rofi/Audio/audio.sh"
  },
  "hyprland/workspaces": {
	    "format": "{icon}",
	    "format-icons": {
        "active": "",
	},
       "persistent-workspaces": {
             "*": 5,
       }
  },
  "cava": {
        // "cava_config": "$XDG_CONFIG_HOME/cava/cava.conf",
        "rotate": 0,
        "framerate": 30,
        "autosens": 1,
        "sensitivity": 0.001,
        "bars": 14,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "hide_on_silence": false,
        // "format_silent": "quiet",
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": false,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": false,
        "noise_reduction": 0.1,
        "input_delay": 2,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
                   "on-click-right": "mode"
                   }
  },
  "custom/launcher": {
    "format": "ア",
    "on-click": "~/.config/rofi/launchers/launcher.sh",
  },
  "custom/power": {
    "format": "",
    "on-click": "wlogout -b 6 -m 400 -r 20 -c 20 --buttons-per-row 5"
  }
}
